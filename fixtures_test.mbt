///|
/// 受控构建清单冒烟：覆盖旧样本没有的 versionCode/versionName 非空字段（SEM 差分可对照）。
test "smoke axml real manifest fx-multidex" {
  let doc = @axml.parse(fixture_fx_multidex_manifest())
  // manifest / uses-sdk / permission / uses-permission / application / activity /
  // intent-filter / action / category
  assert_true(doc.nodes.length() >= 8, msg="manifest 元素数")
  assert_true(doc.pool.strings.length() >= 20, msg="字符串池规模")
  let sem = fx_canon_sem(doc)
  assert_true(
    fx_has_line(sem, "SEM|package|com.fx.multidex"),
    msg="package 语义字段",
  )
  assert_true(
    fx_has_line(sem, "SEM|versionCode|7"),
    msg="versionCode 非空（旧样本为空）",
  )
  assert_true(
    fx_has_line(sem, "SEM|label|Fx Multidex"),
    msg="label 字面量纳入 SEM",
  )
}

///|
/// 子串包含检查（按行匹配，避免误命中行中段）。
fn fx_has_line(s : String, line : String) -> Bool {
  let needle = "\n\{line}\n"
  let padded = "\n" + s
  padded.contains(needle)
}

///|
/// resources.arsc 解析链程序化断言：真实 resources.arsc 的外层 chunk 是
/// RES_TABLE(0x0002)，而 `@axml.parse` 只接受 RES_XML(0x0003) —— 这正是
/// 需要独立 resources.arsc 解析 API（`@axml.parse_arsc`）的实测证据
/// （衔接说明见 tests/ASSETS.md §7）。
test "arsc fixture: RES_TABLE 头与 @axml.parse 现行为" {
  let b = fixture_fx_multidex_arsc()
  assert_true(b[0].to_int() == 0x02, msg="RES_TABLE type 低字节")
  assert_true(b[1].to_int() == 0x00, msg="RES_TABLE type 高字节")
  assert_true(b.length() == 1052, msg="受控构建 arsc 字节数")
  assert_true(fx_raises(b), msg="@axml.parse 对 RES_TABLE 应报 AxmlError")
  assert_true(
    fx_raises(fixture_tvshell_arsc()),
    msg="空表 arsc 同样被 @axml.parse 拒绝",
  )
  assert_true(
    fx_raises(fixture_base_arsc()),
    msg="base 空表 arsc 同样被 @axml.parse 拒绝",
  )
}

///|
/// resources.arsc 黄金常量的结构断言（工具侧口径）：
/// 空表样本的黄金恒为 `ARSC|packages|0`。
test "arsc golden 常量：空表口径" {
  assert_eq(
    golden_tvshell_arsc(),
    "ARSC|packages|0\n",
    msg="tvshell 空表 arsc 黄金",
  )
  assert_eq(
    golden_base_arsc(),
    "ARSC|packages|0\n",
    msg="base 空表 arsc 黄金",
  )
  assert_true(
    golden_fx_multidex_arsc().contains("ARSC|packages|1\n"),
    msg="fx-multidex 单 package 组",
  )
  assert_true(
    golden_fx_multidex_arsc().contains(
      "ARSCVAL|com.fx.multidex|string/app_name|zh|",
    ),
    msg="zh 配置渲染进黄金",
  )
}

///|
/// resources.arsc 解析侧黄金规范化（与 aapt2 dump resources 规范化同构，
/// 口径见 tests/ASSETS.md §4）：
///   ARSC|packages|<N>
///   ARSCPKG|<pkg>|<id>（id 为 2 位小写 hex，如 7f/01）
///   ARSTYPE|<pkg>|<type>|<id>|<entryCount>
///   ARSCENT|<pkg>|<type>/<entry>|<0x%08x>|<PUBLIC|->（PUBLIC = entry.flags & 0x0002）
///   ARSCVAL|<pkg>|<type>/<entry>|<config>|<value>（字符串带引号；config 为裸限定符）
///   ARSCFLAG|<pkg>|<type>/<entry>|<flag>|<id>|<value>（bag map 子行；当前样本不含 bag，
///   attr bag 的 `(attr) type=…` 渲染口径待 framework-res arsc 入链时补齐）
fn fx_canon_arsc(t : @axml.ResTable) -> String {
  let out : Array[String] = []
  out.push("ARSC|packages|\{t.packages.length()}")
  for p in t.packages {
    let pkg = p.name
    out.push("ARSCPKG|\{pkg}|\{fx_hex8(p.id.reinterpret_as_uint())[6:8]}")
    for spec in p.types {
      let tid = spec.id - p.type_id_offset
      let tname = p.type_pool.strings[tid - 1]
      out.push(
        "ARSTYPE|\{pkg}|\{tname}|\{fx_hex8(tid.reinterpret_as_uint())[6:8]}|\{spec.entry_count}",
      )
      let mut idx = 0
      while idx < spec.entry_count {
        let rid_hi = p.id.reinterpret_as_uint() << 24
        let rid_mid = tid.reinterpret_as_uint() << 16
        let rid = rid_hi | rid_mid | idx.reinterpret_as_uint()
        let mut name = ""
        let mut flags = 0
        let mut any = false
        for tc in spec.configs {
          if idx < tc.entries.length() {
            match tc.entries[idx] {
              Some(e) =>
                if !any {
                  name = e.key_name
                  flags = e.flags
                  any = true
                }
              None => ()
            }
          }
        }
        if any {
          let pub_mark = if (flags & 2) != 0 { "PUBLIC" } else { "-" }
          out.push(
            "ARSCENT|\{pkg}|\{tname}/\{name}|0x\{fx_hex8(rid)}|\{pub_mark}",
          )
          for tc in spec.configs {
            if idx < tc.entries.length() {
              match tc.entries[idx] {
                Some(e) => {
                  let cfg = fx_arsc_cfg(tc.config)
                  match e.value {
                    Simple(v) =>
                      out.push(
                        "ARSCVAL|\{pkg}|\{tname}/\{name}|\{cfg}|\{fx_arsc_val(t, v)}",
                      )
                    Complex(b) => {
                      out.push(
                        "ARSCVAL|\{pkg}|\{tname}/\{name}|\{cfg}|(bag) parent=0x\{fx_hex8(b.parent)}",
                      )
                      for m in b.maps {
                        out.push(
                          "ARSCFLAG|\{pkg}|\{tname}/\{name}|\{t.resolve_id(m.name)}|0x\{fx_hex8(m.name)}|\{fx_arsc_val(t, m.value)}",
                        )
                      }
                    }
                  }
                }
                None => ()
              }
            }
          }
        }
        idx = idx + 1
      }
    }
  }
  fx_join(out)
}

///|
/// ResConfig → aapt2 裸限定符（当前口径：默认空串、language、language-rCountry；
/// 非语言限定符的完整 aapt2 语法不在当前样本口径内——样本仅含默认 + zh）。
fn fx_arsc_cfg(c : @axml.ResConfig) -> String {
  if c.is_default() {
    ""
  } else if c.language != "" && c.country == "" {
    c.language
  } else if c.language != "" {
    c.language + "-r" + c.country
  } else {
    "cfg-\{c.sdk_version}"
  }
}

///|
/// ResValue → aapt2 值文本：字符串加引号（aapt2 dump resources 渲染 `"…"`），
/// 其余类型交给 @axml 的 format_value（bool/颜色/int 等与 aapt2 同构）。
fn fx_arsc_val(t : @axml.ResTable, v : @axml.ResValue) -> String {
  let vt : @axml.ResDataType = v.data_type
  match vt {
    String => "\"" + t.format_value(v) + "\""
    _ => t.format_value(v)
  }
}

