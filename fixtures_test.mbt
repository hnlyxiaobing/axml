///|
/// 无符号 32 位小写十六进制（至少 `min_digits` 位，与 aapt2 的 `0x%08x` 渲染一致）。
fn fx_hex8(v : UInt32) -> String {
  let digits = "0123456789abcdef"
  let mut s = ""
  let mut x = v
  let mut n = 0
  while x != 0U {
    let d = (x & 15U).to_byte().to_int()
    s = digits[d:d + 1].to_owned() + s
    x = x >> 4
    n = n + 1
  }
  while n < 8 {
    s = "0" + s
    n = n + 1
  }
  s
}

///|
/// 有符号十进制（aapt2 对 TYPE_INT_DEC 按有符号渲染）。
fn fx_int_dec(v : UInt32) -> String {
  "\{v.reinterpret_as_int()}"
}

///|
/// 属性值规范化：与 `aapt2 dump xmltree` 的渲染逐字段对齐。
fn fx_attr_value(a : @axml.XmlAttribute) -> String {
  match a.raw_value {
    Some(v) => v
    None =>
      match a.value_type {
        Null => "@null"
        Reference => "@0x" + fx_hex8(a.raw_data)
        Attribute => "?0x" + fx_hex8(a.raw_data)
        String => ""
        Float => "?float"
        Dimension => "?dim"
        Fraction => "?frac"
        IntDec => fx_int_dec(a.raw_data)
        IntHex => "0x" + fx_hex8(a.raw_data)
        IntBoolean => if a.raw_data == 0U { "false" } else { "true" }
        Unknown(_) => "?unknown"
      }
  }
}

///|
fn fx_opt(v : String?) -> String {
  match v {
    Some(s) => s
    None => ""
  }
}

///|
/// 取节点上第一个同名属性的**渲染值**（存在即 `Some`；整数/引用按 aapt2 规则渲染）。
fn fx_attr_str(n : @axml.XmlNode, name : String) -> String? {
  let mut res : String? = None
  let mut found = false
  for a in n.attrs() {
    if a.name == name && !found {
      found = true
      res = Some(fx_attr_value(a))
    }
  }
  res
}

///|
/// 只取字符串字面量原值（`raw_value`）：用于与 badging 的资源解析值对齐的字段。
fn fx_attr_raw(n : @axml.XmlNode, name : String) -> String? {
  let mut res : String? = None
  let mut found = false
  for a in n.attrs() {
    if a.name == name && !found {
      found = true
      res = a.raw_value
    }
  }
  res
}

///|
fn fx_join(lines : Array[String]) -> String {
  let mut s = ""
  let mut first = true
  for l in lines {
    if first {
      first = false
    } else {
      s = s + "\n"
    }
    s = s + l
  }
  s + "\n"
}

///|
/// 递归输出 `EL|depth|ns|name` 与 `AT|depth|elem|ns|name|value`（aapt2 规范化同构）。
fn fx_walk(
  doc : @axml.AxmlDoc,
  idx : Int32,
  depth : Int32,
  out : Array[String],
) -> Unit {
  let n = doc.nodes.at(idx)
  if n.chunk is StartElement {
    out.push("EL|\{depth}|\{fx_opt(n.ns)}|\{n.name}")
    for a in n.attrs() {
      out.push(
        "AT|\{depth}|\{n.name}|\{fx_opt(a.ns)}|\{a.name}|\{fx_attr_value(a)}",
      )
    }
    for c in n.children {
      fx_walk(doc, c, depth + 1, out)
    }
  }
}

///|
fn fx_canon_tree(doc : @axml.AxmlDoc) -> String {
  let out : Array[String] = []
  for r in doc.roots {
    fx_walk(doc, r, 0, out)
  }
  fx_join(out)
}

///|
fn fx_canon_pool(doc : @axml.AxmlDoc) -> String {
  let out : Array[String] = []
  let n = doc.pool.strings.length()
  out.push("POOL|\{n}")
  let mut i = 0
  while i < n {
    out.push("STR|\{i}|\{doc.pool.strings.at(i)}")
    i = i + 1
  }
  fx_join(out)
}

///|
/// 该 activity 是否含 MAIN + LAUNCHER intent-filter（即 badging 的 launchable-activity）。
fn fx_is_launcher(doc : @axml.AxmlDoc, act : @axml.XmlNode) -> Bool {
  let mut main = false
  let mut launcher = false
  for ci in act.children {
    let n = doc.nodes.at(ci)
    if n.name == "intent-filter" {
      for ai in n.children {
        let m = doc.nodes.at(ai)
        let v = fx_attr_str(m, "name")
        if m.name == "action" && v == Some("android.intent.action.MAIN") {
          main = true
        }
        if m.name == "category" && v == Some("android.intent.category.LAUNCHER") {
          launcher = true
        }
      }
    }
  }
  main && launcher
}

///|
fn fx_resolve_activity(pkg : String, raw : String) -> String {
  if raw.has_prefix(".") {
    pkg + raw
  } else if raw.contains(".") {
    raw
  } else {
    pkg + "." + raw
  }
}

///|
/// manifest 语义字段规范化（badging 同构；不含 label 资源引用解析）。
fn fx_canon_sem(doc : @axml.AxmlDoc) -> String raise @axml.AxmlError {
  let mut pkg = ""
  let mut vc = ""
  let mut vn = ""
  let mut min_sdk = ""
  let mut tgt_sdk = ""
  let mut label = ""
  let mut has_label = false
  let mut act = ""
  let perms : Array[String] = []
  for e in doc.elements() {
    if e.name == "manifest" && pkg == "" {
      pkg = fx_opt(fx_attr_str(e, "package"))
      vc = fx_opt(fx_attr_str(e, "versionCode"))
      vn = fx_opt(fx_attr_str(e, "versionName"))
    } else if e.name == "uses-sdk" && min_sdk == "" {
      min_sdk = fx_opt(fx_attr_str(e, "minSdkVersion"))
      tgt_sdk = fx_opt(fx_attr_str(e, "targetSdkVersion"))
    } else if e.name == "application" && !has_label {
      match fx_attr_raw(e, "label") {
        Some(v) => {
          label = v
          has_label = true
        }
        None => ()
      }
    } else if e.name == "uses-permission" {
      match fx_attr_str(e, "name") {
        Some(v) => perms.push(v)
        None => ()
      }
    } else if e.name == "activity" && act == "" {
      if fx_is_launcher(doc, e) {
        act = fx_resolve_activity(pkg, fx_opt(fx_attr_str(e, "name")))
      }
    }
  }
  let out : Array[String] = []
  out.push("SEM|package|\{pkg}")
  out.push("SEM|versionCode|\{vc}")
  out.push("SEM|versionName|\{vn}")
  out.push("SEM|minSdk|\{min_sdk}")
  out.push("SEM|targetSdk|\{tgt_sdk}")
  if has_label {
    out.push("SEM|label|\{label}")
  }
  if act != "" {
    out.push("SEM|activity|\{act}")
  }
  for p in perms {
    out.push("SEM|permission|\{p}")
  }
  fx_join(out)
}

///|
test "smoke axml real manifest tvshell-debug" {
  let doc = @axml.parse(fixture_tvshell_manifest())
  assert_true(
    doc.pool.encoding is Utf16,
    msg="tvshell 清单字符串池为 UTF-16",
  )
  assert_eq(doc.pool.strings.length(), 31)
  let elems = doc.elements()
  assert_true(elems.length() >= 8, msg="元素数量")
  assert_true(elems.at(0).name == "manifest", msg="根元素")
  assert_true(
    fx_attr_str(elems.at(0), "package") == Some("com.cteno.tvshell"),
    msg="package",
  )
  assert_true(
    elems.at(0).attrs().length() == 5,
    msg="manifest 属性数（aapt2 xmltree 同为 5 个）",
  )
}

///|
test "smoke axml real manifest base" {
  let doc = @axml.parse(fixture_base_manifest())
  assert_true(
    doc.pool.encoding is Utf16,
    msg="base 清单字符串池为 UTF-16",
  )
  let elems = doc.elements()
  assert_true(elems.at(0).name == "manifest", msg="根元素")
  assert_true(
    fx_attr_str(elems.at(0), "package") == Some("com.mg.motionshell"),
    msg="package",
  )
  let sem = fx_canon_sem(doc)
  assert_true(
    sem.contains("SEM|permission|android.permission.INTERNET"),
    msg="INTERNET 权限",
  )
  assert_true(
    sem.contains("SEM|permission|android.permission.ACCESS_NETWORK_STATE"),
    msg="ACCESS_NETWORK_STATE 权限",
  )
}

///|
test "golden axml tree tvshell-debug" {
  let doc = @axml.parse(fixture_tvshell_manifest())
  assert_eq(fx_canon_tree(doc), golden_tvshell_tree())
}

